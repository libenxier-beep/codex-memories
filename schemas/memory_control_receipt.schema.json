{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/memory_control_receipt.schema.json",
  "title": "Memory Control Plane V1 Workspace Application Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "candidate_hash",
    "approval_id",
    "candidate_set_digest",
    "repository",
    "source_revision",
    "destination",
    "operation",
    "before",
    "after",
    "validation",
    "post_workspace_digest",
    "status",
    "git_published",
    "committed_reader_visible",
    "authorization_strength",
    "recovered",
    "completed_at",
    "receipt_id",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^cand_[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "pattern": "^appr_[0-9a-f]{64}$"},
    "candidate_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "object"},
    "source_revision": {"type": "string"},
    "destination": {"type": "string"},
    "operation": {"enum": ["add", "update", "no_op"]},
    "before": {"type": "object"},
    "after": {"type": "object"},
    "validation": {"type": "array"},
    "post_workspace_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "workspace_applied"},
    "git_published": {"const": false},
    "committed_reader_visible": {"const": false},
    "authorization_strength": {"const": "honest_client_audit"},
    "recovered": {"type": "boolean"},
    "completed_at": {"type": "string", "format": "date-time"},
    "receipt_id": {"type": "string", "pattern": "^workspace_[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
