{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/memory_tombstone.schema.json",
  "title": "Memory Control Plane V1 Tombstone Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tombstone_id",
    "item_id",
    "authority_path",
    "authority_sha256",
    "reason",
    "approval_receipt",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "tombstone_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"},
    "item_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"},
    "authority_path": {"type": "string", "pattern": "^(core|platform|learnings)/.+\\.md$"},
    "authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "approval_receipt": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
