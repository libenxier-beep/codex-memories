{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/memory_candidate.schema.json",
  "title": "Memory Control Plane V1 Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalization_version",
    "operation",
    "destination",
    "draft_write",
    "scope",
    "applies_to",
    "owner",
    "source_refs",
    "source_revision",
    "valid_from",
    "valid_to",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "normalization_version": {"const": 1},
    "operation": {"enum": ["add", "update", "no_op", "tombstone"]},
    "destination": {"type": "string", "minLength": 1, "maxLength": 4096},
    "draft_write": {"type": "string", "maxLength": 262144},
    "scope": {"enum": ["global", "runtime", "platform", "repo", "learning"]},
    "applies_to": {"enum": ["all", "codex", "claude_code", "openclaw"]},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "sha256"],
        "properties": {
          "kind": {
            "enum": [
              "repository_file",
              "conversation_turn",
              "external_evidence",
              "tool_call",
              "tool_result"
            ]
          },
          "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 1024},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "sensitivity": {"enum": ["work", "public", "private", "secret", "credential"]}
  }
}
